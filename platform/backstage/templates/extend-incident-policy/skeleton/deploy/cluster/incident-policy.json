        "storage": true,
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "properties": {
              "spec": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "low",
                      "high",
                      "critical"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    ]
